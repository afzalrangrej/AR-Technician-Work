# Database Configuration
# Default is 'sqlite' (Zero setup required, relational database file created automatically as ./database.db)
# Set to 'mysql' if you have MySQL or MariaDB installed (e.g. XAMPP, WAMP, MySQL Workbench, AWS RDS)

DB_TYPE=sqlite

# MySQL Connection Details (Required only if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=electrohome_db

# Server Configuration
PORT=3000
