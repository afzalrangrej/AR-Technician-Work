DB_TYPE=sqlite
PORT=3000

# To switch to MySQL database server, change DB_TYPE to mysql and configure below:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=electrohome_db

# Google Maps API Key for Live Tracking (Optional - works in dev mode without key)
GOOGLE_MAPS_API_KEY=
